set(jarvis_readelf "@JARVIS_READELF@")
set(jarvis_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@JARVIS_INSTALL_DIR@")
if(NOT IS_DIRECTORY "${jarvis_root}")
    return()
endif()
file(GLOB_RECURSE jarvis_files "${jarvis_root}/*")
set(jarvis_fixed 0)
foreach(jarvis_file IN LISTS jarvis_files)
    if(IS_SYMLINK "${jarvis_file}")
        continue()
    endif()
    execute_process(COMMAND "${jarvis_readelf}" -d "${jarvis_file}"
        OUTPUT_VARIABLE jarvis_dyn ERROR_QUIET RESULT_VARIABLE jarvis_rc)
    if(NOT jarvis_rc EQUAL 0)
        continue()
    endif()
    if(NOT jarvis_dyn MATCHES "\\(R(UN)?PATH\\)")
        continue()
    endif()
    string(REGEX MATCH "Library r(un)?path: \\[([^]]*)\\]" jarvis_ignored "${jarvis_dyn}")
    set(jarvis_cur "${CMAKE_MATCH_2}")
    set(jarvis_absolute FALSE)
    string(REPLACE ":" ";" jarvis_entries "${jarvis_cur}")
    foreach(jarvis_entry IN LISTS jarvis_entries)
        if(NOT jarvis_entry STREQUAL "" AND NOT jarvis_entry MATCHES "^\\$ORIGIN")
            set(jarvis_absolute TRUE)
        endif()
    endforeach()
    if(NOT jarvis_absolute)
        continue()
    endif()
    get_filename_component(jarvis_dir "${jarvis_file}" DIRECTORY)
    file(RELATIVE_PATH jarvis_up "${jarvis_dir}" "${jarvis_root}")
    if(jarvis_up STREQUAL "")
        set(jarvis_new "$ORIGIN")
    else()
        set(jarvis_new "$ORIGIN:$ORIGIN/${jarvis_up}")
    endif()
    string(LENGTH "${jarvis_cur}" jarvis_room)
    string(LENGTH "${jarvis_new}" jarvis_want)
    if(jarvis_want GREATER jarvis_room)
        set(jarvis_new "$ORIGIN")
        string(LENGTH "${jarvis_new}" jarvis_want)
    endif()
    if(jarvis_want GREATER jarvis_room)
        file(RPATH_REMOVE FILE "${jarvis_file}")
        set(jarvis_new "<removed>")
    else()
        file(RPATH_SET FILE "${jarvis_file}" NEW_RPATH "${jarvis_new}")
    endif()
    get_filename_component(jarvis_name "${jarvis_file}" NAME)
    message(STATUS "${jarvis_name}: ${jarvis_cur} -> ${jarvis_new}")
    math(EXPR jarvis_fixed "${jarvis_fixed} + 1")
endforeach()
message(STATUS
    "Made ${jarvis_fixed} bundled libraries resolve relative to their own directory")
