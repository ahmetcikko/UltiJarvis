
set(_vtool "@JARVIS_VTOOL@")
set(_namer "@JARVIS_INSTALL_NAME_TOOL@")
set(_otool "@JARVIS_OTOOL@")
set(_min "@JARVIS_MACOS_MIN@")
set(_bundle "${CMAKE_INSTALL_PREFIX}/@JARVIS_BUNDLE_NAME@")

execute_process(COMMAND find "${_bundle}" -type f
    OUTPUT_VARIABLE _files OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
string(REPLACE "\n" ";" _files "${_files}")

set(_rewritten 0)
set(_stripped 0)
set(_skipped_fat "")
foreach(_f IN LISTS _files)
    execute_process(COMMAND "${_otool}" -l "${_f}"
        OUTPUT_VARIABLE _out ERROR_QUIET RESULT_VARIABLE _rc)
    if(NOT _rc EQUAL 0)
        continue()
    endif()
    string(REGEX MATCHALL "minos ([0-9]+[0-9.]*)" _all "${_out}")
    if(NOT _all)
        continue()
    endif()
    list(LENGTH _all _count)
    if(_count GREATER 1)

        foreach(_entry IN LISTS _all)
            string(REPLACE "minos " "" _v "${_entry}")
            if(_v VERSION_GREATER _min)
                list(APPEND _skipped_fat "${_f}")
            endif()
        endforeach()
        continue()
    endif()

    string(REGEX MATCHALL "path [^ ]+ \\(offset" _rpaths "${_out}")
    foreach(_entry IN LISTS _rpaths)
        string(REGEX REPLACE "^path (.+) \\(offset$" "\\1" _rpath "${_entry}")
        if(NOT _rpath MATCHES "^@")
            execute_process(
                COMMAND "${_namer}" -delete_rpath "${_rpath}" "${_f}"
                RESULT_VARIABLE _nrc ERROR_QUIET OUTPUT_QUIET)
            if(_nrc EQUAL 0)
                math(EXPR _stripped "${_stripped} + 1")
            endif()
        endif()
    endforeach()

    string(REPLACE "minos " "" _current "${_all}")
    if(_current VERSION_GREATER _min)
        execute_process(
            COMMAND "${_vtool}" -set-build-version macos "${_min}" "${_min}"
                    -replace -output "${_f}" "${_f}"
            RESULT_VARIABLE _vrc ERROR_QUIET OUTPUT_QUIET)
        if(NOT _vrc EQUAL 0)
            message(FATAL_ERROR "vtool could not rewrite ${_f}")
        endif()
        math(EXPR _rewritten "${_rewritten} + 1")
    endif()
endforeach()

if(_skipped_fat)
    list(REMOVE_DUPLICATES _skipped_fat)
    message(WARNING
        "these universal binaries still declare a newer minimum: ${_skipped_fat}")
endif()
message(STATUS "Set the macOS minimum to ${_min} on ${_rewritten} binaries, removed ${_stripped} absolute search paths")
