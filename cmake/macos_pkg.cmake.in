
set(_pkgutil "@JARVIS_PKGUTIL@")

foreach(_pkg IN LISTS CPACK_PACKAGE_FILES)
    if(NOT _pkg MATCHES "\\.pkg$")
        continue()
    endif()
    set(_work "${_pkg}.expanded")
    set(_new "${_pkg}.new")
    file(REMOVE_RECURSE "${_work}")
    file(REMOVE "${_new}")
    execute_process(COMMAND "${_pkgutil}" --expand "${_pkg}" "${_work}"
        RESULT_VARIABLE _rc OUTPUT_QUIET ERROR_QUIET)
    if(NOT _rc EQUAL 0)
        message(WARNING "could not unpack ${_pkg}; it will ask for Rosetta")
        continue()
    endif()
    file(READ "${_work}/Distribution" _dist)
    if(NOT _dist MATCHES "hostArchitectures")
        string(REPLACE "<options " "<options hostArchitectures=\"arm64\" "
            _dist "${_dist}")
        file(WRITE "${_work}/Distribution" "${_dist}")
    endif()

    file(GLOB _components "${_work}/*.pkg")
    foreach(_component IN LISTS _components)
        if(NOT EXISTS "${_component}/PackageInfo")
            continue()
        endif()
        file(READ "${_component}/PackageInfo" _info)
        if(_info MATCHES "<relocate>")
            string(REGEX REPLACE "<relocate>.*</relocate>" "" _info "${_info}")
            file(WRITE "${_component}/PackageInfo" "${_info}")
        endif()
    endforeach()

    execute_process(COMMAND "${_pkgutil}" --flatten "${_work}" "${_new}"
        RESULT_VARIABLE _rc OUTPUT_QUIET ERROR_QUIET)
    file(REMOVE_RECURSE "${_work}")
    if(NOT _rc EQUAL 0)
        file(REMOVE "${_new}")
        message(FATAL_ERROR "could not repack ${_pkg}")
    endif()
    file(REMOVE "${_pkg}")
    file(RENAME "${_new}" "${_pkg}")
    message(STATUS "Set hostArchitectures and removed relocation on ${_pkg}")
endforeach()

set(_lsregister "/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister")
set(_staging "@CMAKE_BINARY_DIR@/_CPack_Packages")
set(_unregistered 0)
if(IS_DIRECTORY "${_staging}")
    execute_process(COMMAND find "${_staging}" -maxdepth 8 -type d -name "*.app"
        OUTPUT_VARIABLE _staged OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    string(REPLACE "\n" ";" _staged "${_staged}")
    foreach(_app IN LISTS _staged)
        if("${_app}" STREQUAL "")
            continue()
        endif()
        if(EXISTS "${_lsregister}")
            execute_process(COMMAND "${_lsregister}" -u "${_app}"
                OUTPUT_QUIET ERROR_QUIET)
        endif()
        file(REMOVE_RECURSE "${_app}")
        math(EXPR _unregistered "${_unregistered} + 1")
    endforeach()
endif()
if(_unregistered GREATER 0)
    message(STATUS "Took ${_unregistered} staged bundle(s) out of Launch Services")
endif()
